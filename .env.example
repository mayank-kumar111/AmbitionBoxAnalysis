# Flask runtime
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret

# Local database\AMBITIONBOX_DB_PATH=data/ambitionbox.db

# Optional dataset override
# AMBITIONBOX_DATA_PATH=ambitionbox_app/data/companies.csv

# Scraper settings
SCRAPER_DELAY=1
SCRAPER_TIMEOUT=20

# GitHub Actions notifications (set only in GitHub Secrets)
# SLACK_WEBHOOK_URL=
