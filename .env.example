# Flask runtime
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret

# Local database
AMBITIONBOX_DB_PATH=data/ambitionbox.db

# Optional dataset override
# AMBITIONBOX_DATA_PATH=ambitionbox_app/data/companies.csv

# Scraper settings
SCRAPER_DELAY=1
SCRAPER_TIMEOUT=20

# Refresh API protection. When unset, refresh is loopback-only.
# Plain token mode (development only)
# AMBITIONBOX_REFRESH_TOKEN=replace-with-a-long-random-token
# Hashed token mode (preferred for deployment)
# AMBITIONBOX_REFRESH_TOKEN_HASH=<sha256(salt:token)>
# AMBITIONBOX_REFRESH_TOKEN_SALT=<random-salt>
# Optional active-token expiry as Unix timestamp
# AMBITIONBOX_REFRESH_TOKEN_EXPIRES_AT=1798560000

# Optional previous refresh token during rotation. Remove after the overlap window.
# AMBITIONBOX_REFRESH_TOKEN_PREVIOUS_HASH=<sha256(previous-salt:previous-token)>
# AMBITIONBOX_REFRESH_TOKEN_SALT_PREVIOUS=<previous-random-salt>
# AMBITIONBOX_REFRESH_TOKEN_PREVIOUS_EXPIRES_AT=1798560000
# Raw previous-token mode is also supported with AMBITIONBOX_REFRESH_TOKEN_PREVIOUS.

# Dedicated administrator token required for Apply refreshes on non-loopback deployments.
# Plain token mode (development only)
# AMBITIONBOX_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Hashed token mode (preferred for deployment)
# AMBITIONBOX_ADMIN_TOKEN_HASH=<sha256(salt:admin-token)>
# AMBITIONBOX_ADMIN_TOKEN_SALT=<random-salt>
# Optional active admin-token expiry as Unix timestamp
# AMBITIONBOX_ADMIN_TOKEN_EXPIRES_AT=1798560000

# Optional previous admin token during rotation. Remove after the overlap window.
# AMBITIONBOX_ADMIN_TOKEN_PREVIOUS_HASH=<sha256(previous-salt:previous-admin-token)>
# AMBITIONBOX_ADMIN_TOKEN_SALT_PREVIOUS=<previous-random-salt>
# AMBITIONBOX_ADMIN_TOKEN_PREVIOUS_EXPIRES_AT=1798560000
# Raw previous-token mode is also supported with AMBITIONBOX_ADMIN_TOKEN_PREVIOUS.

# GitHub Actions notifications (set only in GitHub Secrets)
# SLACK_WEBHOOK_URL=
